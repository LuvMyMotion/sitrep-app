# Password that gates access to your dashboard (pick anything).
APP_PASSWORD=

# --- AI features (QC Review, Potential Score, Idea Generator, Captions) ---
# Get this from console.anthropic.com — a separate account/billing from
# claude.ai itself, since API usage is billed per-request.
ANTHROPIC_API_KEY=

# --- YouTube (Google Cloud Console) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=LuvMyMotion

# --- TikTok (developers.tiktok.com) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered in your TikTok app,
# e.g. https://your-app.vercel.app/api/auth/tiktok/callback
TIKTOK_REDIRECT_URI=

# --- Storage ---
# In Vercel: Storage tab -> Create Database -> "Redis" (powered by Upstash) -> Connect.
# This auto-injects KV_REST_API_URL and KV_REST_API_TOKEN — you don't
# need to fill these in by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
